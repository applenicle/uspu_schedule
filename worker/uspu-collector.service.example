[Unit]
Description=USPU timetable sync worker
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=uspu-sync
WorkingDirectory=/opt/uspu-miniapp/worker
ExecStart=/opt/uspu-miniapp/worker/.venv/bin/python /opt/uspu-miniapp/worker/collector.py
Restart=always
RestartSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/uspu-miniapp/worker

[Install]
WantedBy=multi-user.target
